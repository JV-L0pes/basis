# ---------------------------------------------------------------------------
# Basis — environment template. Copy to .env and adjust.
# All backend settings use the BASIS_ prefix (pydantic-settings).
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
BASIS_ENVIRONMENT=local
BASIS_DEBUG=true
BASIS_LOG_LEVEL=INFO
BASIS_SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
BASIS_CORS_ORIGINS=["http://localhost:5173"]

# --- Database ----------------------------------------------------------------
# BASIS_DB_PORT is the host port published by docker compose (default 5432).
BASIS_DB_PORT=5432
BASIS_DATABASE_URL=postgresql+psycopg://basis:basis@localhost:5432/basis
BASIS_TEST_DATABASE_URL=postgresql+psycopg://basis:basis@localhost:5432/basis_test
BASIS_DB_ECHO=false

# --- Auth --------------------------------------------------------------------
BASIS_AUTH__ACCESS_TOKEN_TTL_MINUTES=15
BASIS_AUTH__REFRESH_TOKEN_TTL_DAYS=14
BASIS_AUTH__ALGORITHM=HS256
BASIS_AUTH__BOOTSTRAP_ADMIN_EMAIL=admin@basis.dev
BASIS_AUTH__BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# --- Market data -------------------------------------------------------------
# BRAPI (https://brapi.dev) free tier token — optional, raises rate limits.
BASIS_MARKET_DATA__BRAPI_TOKEN=
BASIS_MARKET_DATA__QUOTE_CACHE_TTL_SECONDS=60
BASIS_MARKET_DATA__HTTP_TIMEOUT_SECONDS=10
BASIS_MARKET_DATA__ALLOW_LIVE_PROVIDERS=true

# --- Frontend (Vite) ---------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Basis
